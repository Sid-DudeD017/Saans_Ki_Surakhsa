# Saans Phase 4 - Command Module
# Local Environment Configuration
# Note: Do not add real access keys here. Do not use static AWS access keys.

# ==============================================================================
# UI Configuration
# Set by: Frontend Developer
# ==============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_USE_MOCKS=true

# ==============================================================================
# External API Keys (Optional/Mocks used if omitted)
# Set by: Backend Developer / Infrastructure
# ==============================================================================
NASA_FIRMS_MAP_KEY=your_firms_map_key_here
OPENAQ_API_KEY=your_openaq_key_here
CPCB_API_KEY=your_cpcb_key_here

# ==============================================================================
# AWS Configuration
# Set by: Infrastructure
# ==============================================================================
AWS_REGION=ap-south-1
AWS_PROFILE=saans

# ==============================================================================
# Agent Kisan Configuration
# Set by: P1. Read by services/agent-kisan (uvicorn doesn't load this file: export them or use --env-file).
# ==============================================================================
# Bedrock models, India-only inference profiles. The simulated farmer in the evaluation is the small
# model on purpose: 200+ runs on Opus would cost several times the evaluation budget.
KISAN_MODEL_ID=in.anthropic.claude-opus-5
KISAN_FARMER_MODEL_ID=in.anthropic.claude-haiku-4-5-20251001-v1:0
KISAN_BEDROCK_REGION=ap-south-1
KISAN_CHC_SEED=data/seed/chc_demo.json
# Filings go here until SAANS_API_URL is set (below).
KISAN_OUTBOX=.outbox/support_requests.jsonl
# Speech: local = faster-whisper on this machine; sagemaker = the Whisper endpoint (set its name).
KISAN_ASR_BACKEND=local
KISAN_ASR_MODEL=large-v3-turbo
KISAN_ASR_ENDPOINT=
# Read-back voice threads; empty = the CPUs this container may use.
KISAN_TTS_THREADS=
# Farmer SMS: sns = Amazon SNS (needs a DLT-registered sender ID in India); anything else = the outbox file.
KISAN_SMS=outbox
KISAN_SMS_OUTBOX=.outbox/sms.jsonl
KISAN_SMS_SENDER_ID=
# Shared secret Command sends as X-Saans-Service-Token when it reports progress. Empty = updates are off.
# Generate one per environment; never commit a real value.
KISAN_SERVICE_TOKEN=
# Cleaned farm photos (faces blurred, metadata removed).
KISAN_PHOTOS=.outbox/photos

# ==============================================================================
# Saans API Configuration
# Set by: P4 (base URLs without /v1; each client adds the path)
# ==============================================================================
# Command's API, where Kisan files help requests (POST /v1/complaints). Empty = Kisan uses KISAN_OUTBOX.
# Locally, with `npm run stack` and `npm run dev`: http://localhost:3000
SAANS_API_URL=
# P3's air-data service (GET /v1/fires, /v1/aqi). Locally that's the Next.js app.
SAANS_AQI_URL=http://localhost:3000
# Where the Next.js app forwards /v1/agent/kisan/* (the Kisan screens). Server-side only; deployed, the
# API gateway routes those paths to the agent instead.
KISAN_AGENT_URL=http://127.0.0.1:8001

# ==============================================================================
# Domain Logic Configuration
# Set by: Backend Developer
# ==============================================================================
SATELLITE_MATCH_MAX_DISTANCE_METERS=1000
SATELLITE_MATCH_MAX_HOURS_BEFORE=24
SATELLITE_MATCH_MAX_HOURS_AFTER=6
SATELLITE_MATCH_MIN_CONFIDENCE=70
HELP_REQUEST_MAX_DISTANCE_METERS=5000
HELP_REQUEST_TIE_TOLERANCE_METERS=100

# ==============================================================================
# Saans Command intake (G5)
# Set by: P4. Defaults match infra/compose.yaml (`npm run stack`); the user and password are local fixtures.
# ==============================================================================
SAANS_DATABASE_URL=postgres://saans:saans@127.0.0.1:5433/saans
SAANS_EVIDENCE_BUCKET=saans-evidence
# LocalStack's S3. Leave it out on AWS.
LOCALSTACK_URL=http://127.0.0.1:4566
